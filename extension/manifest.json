{
  "manifest_version": 3,
  "name": "Kawawa",
  "version": "0.1.0",
  "description": "SNS(X)の文字を、かわいく丸く、ちょっとざんねんなキャワワにします。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
